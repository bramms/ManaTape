<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>local.manatape</string>
  <key>ProgramArguments</key><array>
    <string>/ABSOLUTE/PATH/ManaTape/.venv/bin/python</string>
    <string>/ABSOLUTE/PATH/ManaTape/server.py</string>
    <string>--config</string><string>/Users/YOUR_USER/.config/mana-tape/installation.yml</string>
  </array>
  <key>WorkingDirectory</key><string>/ABSOLUTE/PATH/ManaTape</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>Umask</key><integer>63</integer>
</dict></plist>
